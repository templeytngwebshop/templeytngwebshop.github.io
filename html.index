<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Templeyt</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial, sans-serif;
  height:100vh;
  display:flex;
  background:#f5f6fa;
  color:#333;
}

/* SIDEBAR */

.sidebar{
  width:280px;
  background:#ffffff;
  border-right:1px solid #ddd;
  display:flex;
  flex-direction:column;
}

.logo{
  padding:20px;
  font-size:28px;
  font-weight:bold;
  color:#4f46e5;
  border-bottom:1px solid #eee;
}

.search{
  padding:15px;
}

.search input{
  width:100%;
  padding:12px;
  border:none;
  border-radius:8px;
  background:#f1f3f6;
  outline:none;
  font-size:14px;
}

.notes-list{
  flex:1;
  overflow-y:auto;
  padding:10px;
}

.note-item{
  background:#f9fafc;
  padding:15px;
  margin-bottom:10px;
  border-radius:10px;
  cursor:pointer;
  transition:0.2s;
  border:1px solid transparent;
}

.note-item:hover{
  background:#eef2ff;
}

.note-item.active{
  border:1px solid #4f46e5;
  background:#eef2ff;
}

.note-title{
  font-weight:bold;
  margin-bottom:5px;
}

.add-btn{
  margin:15px;
  padding:14px;
  border:none;
  border-radius:10px;
  background:#4f46e5;
  color:white;
  font-size:16px;
  cursor:pointer;
  transition:0.2s;
}

.add-btn:hover{
  background:#4338ca;
}

/* MAIN */

.main{
  flex:1;
  display:flex;
  flex-direction:column;
}

.topbar{
  padding:20px;
  background:white;
  border-bottom:1px solid #ddd;
}

.title-input{
  width:100%;
  font-size:28px;
  font-weight:bold;
  border:none;
  outline:none;
}

.editor{
  flex:1;
  padding:25px;
}

textarea{
  width:100%;
  height:100%;
  border:none;
  resize:none;
  outline:none;
  font-size:16px;
  line-height:1.7;
  background:transparent;
}

.empty{
  display:flex;
  justify-content:center;
  align-items:center;
  height:100%;
  color:#888;
  font-size:20px;
}

/* MOBILE */

@media(max-width:768px){

  body{
    flex-direction:column;
  }

  .sidebar{
    width:100%;
    height:300px;
  }

  .main{
    height:calc(100vh - 300px);
  }

}
</style>
</head>

<body>

<div class="sidebar">

  <div class="logo">
    Templeyt
  </div>

  <div class="search">
    <input type="text" id="search" placeholder="Search notes...">
  </div>

  <div class="notes-list" id="notesList"></div>

  <button class="add-btn" onclick="createNote()">
    + New Note
  </button>

</div>

<div class="main">

  <div class="topbar">
    <input 
      type="text" 
      id="title"
      class="title-input"
      placeholder="Untitled Note"
    >
  </div>

  <div class="editor">
    <textarea 
      id="content"
      placeholder="Start writing here..."
    ></textarea>
  </div>

</div>

<script>

let notes = JSON.parse(localStorage.getItem("templeyt-notes")) || [];

let activeNote = null;

const notesList = document.getElementById("notesList");
const titleInput = document.getElementById("title");
const contentInput = document.getElementById("content");
const searchInput = document.getElementById("search");

/* CREATE NOTE */

function createNote(){

  const newNote = {
    id: Date.now(),
    title: "Untitled Note",
    content: ""
  };

  notes.unshift(newNote);

  saveNotes();

  renderNotes();

  openNote(newNote.id);

}

/* SAVE */

function saveNotes(){
  localStorage.setItem(
    "templeyt-notes",
    JSON.stringify(notes)
  );
}

/* RENDER NOTES */

function renderNotes(filter=""){

  notesList.innerHTML = "";

  const filtered = notes.filter(note =>
    note.title.toLowerCase().includes(filter.toLowerCase()) ||
    note.content.toLowerCase().includes(filter.toLowerCase())
  );

  filtered.forEach(note => {

    const div = document.createElement("div");

    div.classList.add("note-item");

    if(activeNote && activeNote.id === note.id){
      div.classList.add("active");
    }

    div.innerHTML = `
      <div class="note-title">${note.title}</div>
      <div>${note.content.substring(0,50)}</div>
    `;

    div.onclick = () => openNote(note.id);

    notesList.appendChild(div);

  });

}

/* OPEN NOTE */

function openNote(id){

  activeNote = notes.find(note => note.id === id);

  titleInput.value = activeNote.title;

  contentInput.value = activeNote.content;

  renderNotes(searchInput.value);

}

/* UPDATE NOTE */

titleInput.addEventListener("input", () => {

  if(!activeNote) return;

  activeNote.title = titleInput.value;

  saveNotes();

  renderNotes(searchInput.value);

});

contentInput.addEventListener("input", () => {

  if(!activeNote) return;

  activeNote.content = contentInput.value;

  saveNotes();

  renderNotes(searchInput.value);

});

/* SEARCH */

searchInput.addEventListener("input", () => {
  renderNotes(searchInput.value);
});

/* INIT */

renderNotes();

if(notes.length > 0){
  openNote(notes[0].id);
}

</script>

</body>
</html>